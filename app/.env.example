# Supabase (local stack: `npx supabase start`; hosted: project settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…

# Chain data provider for wallet sync (read-only). Without it the app says "Chain sync: not configured" and CSV import is the only source.
# Create the key with the Web3Rails account, never a personal one. Server-side only: no NEXT_PUBLIC_ prefix.
HELIUS_API_KEY=

# HMAC shared with Supabase Vault (secret "attestation_hmac"): verdicts of wallet-ownership attestations. Generate with `openssl rand -hex 32`.
ATTESTATION_HMAC_SECRET=

# Solana anchor key (base58 secret key) and cluster for export checksum anchoring. Server only. Devnet for the hackathon.
SOLANA_ANCHOR_SECRET_KEY=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
